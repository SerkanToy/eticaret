@page "~/blog-detail"
@model eticaret.Pages.Blog.BlogDetailModel
@{
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

@(await Html.RenderComponentAsync<eticaret.Pages.Shared.Components.Breadcrumb.BreadcrumbComponent>(RenderMode.ServerPrerendered, new { Title = "Blog", Titles = new List<string> { "Blog","Blog Detay", $"{Model.blogDetailViewModel.Title}" } }))

<section class="section-blog-details padding-tb-50">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="bb-blog-details-contact" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="400">
                    <div class="inner-blog-details-image">
                        <img src="assets/img/blog-details/one.jpg" alt="details-one">
                    </div>
                    <div class="inner-blog-details-contact">
                        <div style="display:flex;flex-direction:row;justify-content:space-between;">
                            <span>@Model.blogDetailViewModel.CreateBy</span>
                            <span>@Model.blogDetailViewModel.CreateDate</span>
                        </div>
                        <br />
                        <h4 class="sub-title">@Model.blogDetailViewModel.Title</h4>
                        <p>
                            @Model.blogDetailViewModel.Description
                        </p>
                        <p>
                            @Model.blogDetailViewModel.Description
                        </p>
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="blog-inner-image">
                                    <img src="assets/img/blog/1.jpg" alt="blog-1">
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="blog-inner-image">
                                    <img src="assets/img/blog/2.jpg" alt="blog-2">
                                </div>
                            </div>
                        </div>
                        <p>
                            @Model.blogDetailViewModel.Description
                        </p>
                        <p>
                            @Model.blogDetailViewModel.Description
                        </p>
                    </div>
                    <div class="row mb-minus-24">
                        @if (Model.blogViewModel.Any())
                        {
                            foreach (var blog in Model.blogViewModel)
                            {
                                <div class="col-lg-3 col-md-6 col-12 mb-24" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="200">
                                    <div class="bb-blog-card">
                                        <div class="blog-image">
                                            <img src="assets/img/blog/1.jpg" alt="blog-1">
                                        </div>
                                        <div class="blog-contact">
                                            <h5><a asp-page="BlogDetail" asp-route-id="@blog.Id">@blog.Title</a></h5>
                                            <div style="display: flex;flex-direction:row;justify-content:space-between;font-size:12px;">
                                                <span>@(blog.ModifiedBy ?? blog.CreateBy)</span>
                                                <span>@(blog.ModifiedDate ?? blog.CreateDate)</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <br />
                    <br />

                    @(await Html.RenderComponentAsync<eticaret.Pages.Shared.Components.Comment.CommentComponent>(RenderMode.ServerPrerendered, new { id = $"{Model.blogDetailViewModel.Id}" }))


                </div>
            </div>
        </div>
    </div>
</section>

