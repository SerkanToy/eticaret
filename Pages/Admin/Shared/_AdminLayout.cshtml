<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <base href="~/" />


    <link href="~/adminassets/assets/css/bootstrap.min.css" id="bootstrap-style" rel="stylesheet" type="text/css" asp-append-version="true" />
    <!-- Icons Css -->
    <link href="~/adminassets/assets/css/icons.min.css" rel="stylesheet" type="text/css" asp-append-version="true" />
    <!-- App Css-->
    <link href="~/adminassets/assets/css/app.min.css" id="app-style" rel="stylesheet" type="text/css" asp-append-version="true" />
    <!-- App js -->
    <script src="~/adminassets/assets/js/plugin.js"></script>

</head>
<body data-topbar="dark" data-layout="horizontal">
	@RenderBody()
    


    <script src="_framework/blazor.server.js"></script>
    <!-- JAVASCRIPT -->
    <script src="~/adminassets/assets/libs/jquery/jquery.min.js"></script>
    <script src="~/adminassets/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/adminassets/assets/libs/metismenu/metisMenu.min.js"></script>
    <script src="~/adminassets/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/adminassets/assets/libs/node-waves/waves.min.js"></script>

    <!-- apexcharts -->
    <script src="~/adminassets/assets/libs/apexcharts/apexcharts.min.js"></script>

    <script src="~/adminassets/assets/js/pages/dashboard.init.js"></script>

    <script src="~/adminassets/assets/js/app.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    
    
</body>
</html>
