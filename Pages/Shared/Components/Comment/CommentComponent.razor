@using Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using eticaret.Domain.Repository.Interface
@inject IJSRuntime JS


<div class="bb-blog-details-comment" id="commentlist">
    

	
    
</div>


<eticaret.Pages.Shared.Components.LeaveComment.LeaveCommentComponent CommetId="@id"/>


<script type="text/javascript">
    function comment(id) {
            var html = '';
            var connection = new signalR.HubConnectionBuilder().withUrl("https://localhost:7102/WebHub").build();
              connection.start().then(() => {
                  $("#commentlist").text(connection.state);
                  setInterval(() => {
                      connection.invoke("SendBlogComment",id);
                  }, 1000);
              }).catch((err) => { console.log(err) });

              connection.on("BlogComment", (blogcomment) => {
                      html = `<div class="main-title"><h4>Yorumlar</h4></div><br/>`;
                      $.each(blogcomment, function( key, value ) {
                           html += `<div class="bb-comment-box">
                                        <div class="inner-image" style="background-color: #6c7fd8;color: white;height: 45px;padding: 10px 15px;border-radius: 10px;font-size: 30px;">
                                            ${value.createBy.substring(0, 1)}
                                        </div>
                                        <div class="inner-contact">
                                            <h5 class="sub-title">${value.createBy}</h5>
                                            <span>${value.title}</span>
                                            <p>
                                                ${value.description}
                                            </p>
                                        </div>
                                    </div><br/>`
                                });
                  $('#commentlist').html(html);
               });
    }
</script>
@code {
    [Parameter]
    public string? id { get; set; }

    protected async override Task OnInitializedAsync()
    {
        //await JS.InvokeVoidAsync("Testing");

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("comment",id);        
    }

}
